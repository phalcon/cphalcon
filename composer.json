{
  "name": "phalcon/cphalcon",
  "type": "php-ext",
  "description": "Phalcon is an open source web framework delivered as a C extension for the PHP language providing high performance and lower resource consumption.",
  "keywords": [
    "extension",
    "phalcon",
    "framework",
    "high load",
    "mvc"
  ],
  "license": "BSD-3-Clause",
  "php-ext": {
    "extension-name": "phalcon",
    "build-path": "build/phalcon"
  },
  "authors": [
    {
      "name": "Phalcon Team",
      "email": "team@phalcon.io",
      "homepage": "https://phalcon.io/en/team"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/phalcon/cphalcon/graphs/contributors"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "ext-apcu": "*",
    "ext-dom": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-igbinary": "*",
    "ext-imagick": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-msgpack": "*",
    "ext-pcntl": "*",
    "ext-pdo": "*",
    "ext-redis": "*",
    "ext-sqlite3": "*",
    "ext-xml": "*",
    "friendsofphp/php-cs-fixer": "^3.95",
    "mustache/mustache": "^3.2",
    "phalcon/ide-stubs": "^5.13.0",
    "phalcon/talon": "^0.6.0",
    "phalcon/zephir": "dev-development",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5",
    "predis/predis": "^3.4",
    "squizlabs/php_codesniffer": "^4.0",
    "twig/twig": "^3.27",
    "vimeo/psalm": "^6.16",
    "vlucas/phpdotenv": "^5.6"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zephir\\Optimizers\\FunctionCall\\": "optimizers/",
      "Phalcon\\Tests\\": "tests/",
      "Phalcon\\Tests\\Support\\": "tests/support/",
      "Phalcon\\Tests\\Unit\\": "tests/unit/",
      "Phalcon\\Tests\\Database\\": "tests/database/"
    },
    "exclude-from-classmap": [
      "tests/support/assets/"
    ]
  },
  "support": {
    "email": "support@phalcon.io",
    "issues": "https://github.com/phalcon/cphalcon/issues",
    "forum": "https://phalcon.io/forum/",
    "source": "https://github.com/phalcon/cphalcon",
    "docs": "https://phalcon.io/docs/",
    "rss": "https://blog.phalcon.io/rss"
  },
  "scripts": {
    "analyze": "php -d extension=ext/modules/phalcon.so ./vendor/bin/psalm -c resources/psalm.xml --no-cache",
    "cs": "php -d extension=ext/modules/phalcon.so ./vendor/bin/phpcs --standard=resources/phpcs.xml",
    "cs-fix": "php -d extension=ext/modules/phalcon.so ./vendor/bin/phpcbf --standard=resources/phpcs.xml",
    "cs-fixer": "php -d extension=ext/modules/phalcon.so vendor/bin/php-cs-fixer fix --config=resources/php-cs-fixer.php --dry-run --diff",
    "cs-fixer-fix": "php -d extension=ext/modules/phalcon.so vendor/bin/php-cs-fixer fix --config=resources/php-cs-fixer.php",
    "test-unit": "talon run unit",
    "test-unit-debug": "talon run unit -- --fail-on-all-issues --display-all-issues",
    "test-unit-coverage": "talon run unit -- --coverage-clover tests/_output/coverage.xml",
    "test-unit-coverage-html": "talon run unit -- --coverage-html tests/_output/coverage/",
    "test-db-mysql": "talon run mysql",
    "test-db-mysql-debug": "talon run mysql -- --fail-on-all-issues --display-all-issues",
    "test-db-mysql-coverage": "talon run mysql -- --coverage-clover tests/_output/coverage.xml",
    "test-db-pgsql": "talon run pgsql",
    "test-db-pgsql-debug": "talon run pgsql -- --fail-on-all-issues --display-all-issues",
    "test-db-pgsql-coverage": "talon run pgsql -- --coverage-clover tests/_output/coverage.xml",
    "test-db-sqlite": "talon run sqlite",
    "test-db-sqlite-debug": "talon run sqlite -- --fail-on-all-issues --display-all-issues",
    "test-db-sqlite-coverage": "talon run sqlite -- --coverage-clover tests/_output/coverage.xml",
    "test-db": "talon run mysql pgsql sqlite",
    "test-all": "talon run all",
    "clean-build-stubs": [
      "./vendor/bin/zephir fullclean",
      "Composer\\Config::disableProcessTimeout",
      "./vendor/bin/zephir build",
      "./vendor/bin/zephir stubs"
    ]
  }
}
