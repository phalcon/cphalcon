#!/usr/bin/env bash
#
# This file is part of the Phalcon Framework.
#
# (c) Phalcon Team <team@phalcon.io>
#
# For the full copyright and license information, please view
# the LICENSE.txt file that was distributed with this source code.

# Counts the memory allocations of one benchmark subject with valgrind (DHAT).
# Run this script in the cphalcon-bench-* container.
#
# Usage: tests/benchmarks/bin/allocs <build> <class> <method> [k]
#
# The script runs the subject one time without valgrind (warm-up: file caches). Then it runs the subject
# 0, 1 and 1+k times under DHAT with USE_ZEND_ALLOC=0 (k is 100 if not given). Each emalloc is then one
# malloc, so the block count of DHAT is the allocation count:
#   cold: the first call (1 call minus 0 calls)
#   warm: one later call ((1+k calls minus 1 call) / k)
#
# Result: .local/bench/out/allocs/<build>/<class with dots>-<method>.txt

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
readonly ROOT
readonly BIN="${ROOT}/tests/benchmarks/bin"

usage() {
    echo "Usage: $0 <build> <class> <method> [k]  (k: a positive integer, default 100)" >&2
    exit 2
}

[[ $# -ge 3 && $# -le 4 ]] || usage

build="$1"
class="$2"
method="$3"
k="${4:-100}"

[[ "${k}" =~ ^[1-9][0-9]{0,6}$ ]] || usage

out="${ROOT}/.local/bench/out/allocs/${build}"
name="${class//\\/.}-${method}"
mkdir -p "${out}"

# Warm-up run without valgrind. It creates the file caches (for example compiled views and model
# metadata), so that no measured run creates them.
warm_up_errors="${out}/${name}-warm-up.stderr"
if ! "${BIN}/php-bench" "${build}" "${BIN}/subject.php" "${class}" "${method}" "$(printf '%09d' 1)" \
    > /dev/null 2> "${warm_up_errors}"; then
    echo "Error: the warm-up run failed. See ${warm_up_errors}" >&2
    exit 1
fi

# Prints "<bytes> <blocks>" of one run with <count> subject calls.
count_allocs() {
    # Fixed width: the argument length changes the allocations
    local count
    count="$(printf '%09d' "$1")"
    local errors="${out}/${name}-n${count}.stderr"

    if ! "${BIN}/php-bench" --no-zend-alloc \
        --prefix "valgrind --tool=dhat --vgdb=no --dhat-out-file=/dev/null" \
        "${build}" "${BIN}/subject.php" "${class}" "${method}" "${count}" > /dev/null 2> "${errors}"; then
        echo "Error: the run with ${count} calls failed. See ${errors}" >&2
        return 1
    fi

    local total
    total="$(sed -n 's/^==[0-9]*== Total: *\([0-9,]*\) bytes in \([0-9,]*\) blocks.*/\1 \2/p' "${errors}" | tr -d ',')"
    if [[ ! "${total}" =~ ^[0-9]+\ [0-9]+$ ]]; then
        echo "Error: no DHAT total in ${errors}" >&2
        return 1
    fi

    echo "${total}"
}

read -r bytes_0 blocks_0 <<< "$(count_allocs 0)"
read -r bytes_1 blocks_1 <<< "$(count_allocs 1)"
read -r bytes_k blocks_k <<< "$(count_allocs $((k + 1)))"

per_call() {
    awk -v high="$1" -v low="$2" -v k="$3" 'BEGIN { printf "%.1f", (high - low) / k }'
}

{
    echo "build=${build}"
    echo "subject=${class}::${method}"
    echo "k=${k}"
    echo "cold_allocations=$((blocks_1 - blocks_0))"
    echo "cold_bytes=$((bytes_1 - bytes_0))"
    echo "warm_allocations=$(per_call "${blocks_k}" "${blocks_1}" "${k}")"
    echo "warm_bytes=$(per_call "${bytes_k}" "${bytes_1}" "${k}")"
    echo "date=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "${out}/${name}.txt"

echo "subject=${class}::${method}"
sed -n '/^\(cold\|warm\)_/p' "${out}/${name}.txt"
