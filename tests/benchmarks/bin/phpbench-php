# PHPBench runs this script as its PHP binary (see resources/phpbench.json).
# It runs PHP through php-bench. The build name comes from PHP_BENCH_BUILD. If PHP_BENCH_CPU is set,
# each child process runs on that CPU only.
#
# Usage: PHP_BENCH_BUILD=<build> [PHP_BENCH_CPU=<n>] vendor/bin/phpbench run --config=resources/phpbench.json ...

set -euo pipefail

if [[ -z "${PHP_BENCH_BUILD:-}" ]]; then
    echo "Error: set PHP_BENCH_BUILD to a build name in .local/bench/so/." >&2
    exit 2
fi

cpu_option=()
if [[ -n "${PHP_BENCH_CPU:-}" ]]; then
    cpu_option=(--cpu "${PHP_BENCH_CPU}")
fi

exec "$(dirname "$0")/php-bench" "${cpu_option[@]}" "${PHP_BENCH_BUILD}" "$@"
