# PHPBench runs this script as its PHP binary (see resources/phpbench.json).
# It runs PHP through php-bench. The build name comes from PHP_BENCH_BUILD.
#
# Usage: PHP_BENCH_BUILD=<build> vendor/bin/phpbench run --config=resources/phpbench.json ...

set -euo pipefail

if [[ -z "${PHP_BENCH_BUILD:-}" ]]; then
    echo "Error: set PHP_BENCH_BUILD to a build name in .local/bench/so/." >&2
    exit 2
fi

exec "$(dirname "$0")/php-bench" "${PHP_BENCH_BUILD}" "$@"
